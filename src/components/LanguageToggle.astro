---
import type { Language } from "../i18n/languages";

const { id = "language-switcher" } = Astro.props;
const currentLocale = (Astro.currentLocale || "es") as Language;
const languages = [
  { code: "es", label: "ES", name: "Español", href: "/" },
  { code: "en", label: "EN", name: "English", href: "/en/" },
];
---

<div id={id} role="group" aria-label={currentLocale === 'en' ? 'Language' : 'Idioma'} class="flex items-center gap-0.5">
  {languages.map((language) => (
    <a
      href={language.href}
      lang={language.code}
      hreflang={language.code}
      aria-label={`${language.label}: ${language.name}`}
      aria-current={language.code === currentLocale ? "page" : undefined}
      title={language.name}
      class:list={[
        'language-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg px-2 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500',
        language.code === currentLocale
          ? 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300'
          : 'text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800',
      ]}
    >
      {language.label}
    </a>
  ))}
</div>
