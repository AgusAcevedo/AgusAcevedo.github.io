---
import { useTranslations } from "../i18n";
import type { Language } from "../i18n/languages";

const currentLocale = (Astro.currentLocale || 'es') as Language;
const t = useTranslations(currentLocale);

const projectsData = t.myProjects.items;
const isEn = currentLocale === 'en';
// Descriptions are repository-authored rich text. Render the supported paragraph
// and emphasis structure as escaped Astro values instead of injecting HTML.
const descriptionParagraphs = (description: string) =>
  Array.from(description.matchAll(/<p(?: class="mt-4")?>(.*?)<\/p>/gs), ([, paragraph]) =>
    paragraph.split(/(<strong>.*?<\/strong>)/gs).map((part) => ({
      strong: part.startsWith('<strong>') && part.endsWith('</strong>'),
      text: part.startsWith('<strong>') && part.endsWith('</strong>') ? part.slice(8, -9) : part,
    }))
  );
---

<div id="projects-region" class="space-y-8" role="region" aria-label={t.myProjects.title} aria-roledescription={isEn ? "carousel" : "carrusel"} data-locale={currentLocale}>
  <!-- Carousel Container -->
  <div class="relative">
    <!-- Carousel Track -->
    <div class="overflow-hidden px-4 sm:px-0">
      <div id="projects-carousel" class="flex transition-transform duration-500 ease-out motion-reduce:transition-none">
        {projectsData.map((project, index) => (
          <article
            class="project-card flex-shrink-0 w-full md:w-1/2 lg:w-1/3 px-3"
            data-project-id={project.id}
            data-index={index}
          >
            <div class="group relative overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50 transition-all hover:border-violet-400 dark:hover:border-violet-600 hover:shadow-xl hover:shadow-violet-500/10 dark:hover:shadow-violet-500/5 h-full">
              {project.image && (
                <div class="aspect-video overflow-hidden bg-gradient-to-br from-violet-500/10 to-blue-500/10 dark:from-violet-500/5 dark:to-blue-500/5">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              
              <div class="p-6 space-y-4">
                <h3 id={`project-card-title-${project.id}`} class="text-xl font-bold text-gray-800 dark:text-white leading-tight group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">
                  {project.title}
                </h3>

                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-3">
                  {project.shortDescription}
                </p>

                {project.tags && project.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map((tag: string) => (
                      <span class="text-xs px-2 py-1 rounded-full bg-violet-100 dark:bg-violet-900/40 text-violet-600 dark:text-violet-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <button
                type="button"
                data-project-dialog={`project-modal-${project.id}`}
                aria-labelledby={`project-card-title-${project.id}`}
                aria-controls={`project-modal-${project.id}`}
                aria-haspopup="dialog"
                class="absolute inset-0 z-10 w-full h-full rounded-2xl cursor-pointer focus-visible:outline-2 focus-visible:outline-violet-500 focus-visible:outline-offset-[-2px]"
              >
                <span class="sr-only">{project.title}</span>
              </button>
              <!-- Decorative gradient -->
              <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-violet-500/5 to-transparent rounded-full blur-2xl -z-10 group-hover:from-violet-500/10 transition-all" />
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Navigation Controls -->
    <nav class="flex items-center justify-center gap-4 mt-6" aria-label={isEn ? "Project pagination" : "Paginación de proyectos"}>
      <button
        id="projects-prev"
        class="px-4 py-2 rounded-lg font-semibold border transition disabled:opacity-30 disabled:cursor-not-allowed bg-violet-100 text-violet-700 border-violet-200 hover:bg-violet-200 dark:bg-violet-600/20 dark:text-white dark:border-violet-600/40 dark:hover:bg-violet-600/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
        aria-label={isEn ? "Previous projects" : "Proyectos anteriores"} aria-controls="projects-carousel"
      >
        &lt;
      </button>
      <div id="projects-dots" class="flex justify-center gap-1" role="group" aria-label={isEn ? "Choose project position" : "Elegir posición de proyectos"}>
        <!-- Dots will be generated dynamically -->
      </div>
      <button
        id="projects-next"
        class="px-4 py-2 rounded-lg font-semibold border transition disabled:opacity-30 disabled:cursor-not-allowed bg-violet-100 text-violet-700 border-violet-200 hover:bg-violet-200 dark:bg-violet-600/20 dark:text-white dark:border-violet-600/40 dark:hover:bg-violet-600/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
        aria-label={isEn ? "Next projects" : "Proyectos siguientes"} aria-controls="projects-carousel"
      >
        &gt;
      </button>
    </nav>
  </div>
  <p id="projects-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<!-- Render content once; opening a project never injects HTML from JavaScript. -->
{projectsData.map((project) => (
  <dialog
    id={`project-modal-${project.id}`}
    class="project-dialog m-auto w-[calc(100%_-_2rem)] max-w-4xl max-h-[90dvh] overflow-y-auto rounded-2xl bg-white dark:bg-gray-900 text-gray-800 dark:text-white p-0 shadow-2xl"
    aria-labelledby={`project-modal-title-${project.id}`}
  >
    <div class="relative p-6 sm:p-8">
      <button
        type="button"
        data-dialog-close
        class="absolute top-4 right-4 z-10 flex items-center justify-center size-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
        aria-label={t.myProjects.modal.close}
      >
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path>
        </svg>
      </button>
      {project.image && <img src={project.image} alt="" loading="lazy" class="w-full aspect-video object-cover rounded-xl mb-6" />}
      <h2 id={`project-modal-title-${project.id}`} tabindex="-1" data-dialog-initial-focus class="text-3xl font-bold text-gray-800 dark:text-white mb-4 pr-8">{project.title}</h2>
      <div class="flex flex-wrap gap-2 mb-6">
        {project.tags.map((tag: string) => <span class="text-xs px-3 py-1 rounded-full bg-violet-100 dark:bg-violet-900/40 text-violet-600 dark:text-violet-400">{tag}</span>)}
      </div>
      <div class="prose prose-gray dark:prose-invert max-w-none text-gray-600 dark:text-gray-400 space-y-4">
        {descriptionParagraphs(project.description).map((paragraph) => <p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>)}
      </div>
      {(project.github || project.demo) && <div class="flex flex-wrap gap-4 mt-6">
        {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">{t.myProjects.modal.repository} ↗</a>}
        {project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-violet-600 hover:bg-violet-700 text-white transition-colors">{t.myProjects.modal.demo} ↗</a>}
      </div>}
    </div>
  </dialog>
))}

<style>
  .project-card { animation: fadeInUp 0.5s ease-out both; }
  .project-card:nth-child(1) { animation-delay: 0.1s; }
  .project-card:nth-child(2) { animation-delay: 0.2s; }
  .project-card:nth-child(3) { animation-delay: 0.3s; }
  @keyframes fadeInUp { from { opacity: 0; } to { opacity: 1; } }
  .project-dialog::backdrop { background: rgb(0 0 0 / 0.7); backdrop-filter: blur(4px); }
  @media (prefers-reduced-motion: reduce) {
    .project-card { animation: none; }
    .project-card img { transition: none; transform: none; }
  }
</style>

<script>
  import { bindDialog } from "../scripts/dialog";

  function initProjects() {
    const region = document.getElementById("projects-region");
    const carousel = document.getElementById("projects-carousel");
    const dotsContainer = document.getElementById("projects-dots");
    const prevBtn = document.getElementById("projects-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("projects-next") as HTMLButtonElement | null;
    const status = document.getElementById("projects-status");
    if (!region || !carousel || !dotsContainer) return;
    const isEn = region.dataset.locale === "en";
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>(".project-card"));
    let currentSlide = 0;
    let activeCard: HTMLElement | null = null;
    const getItemsPerView = () => window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
    let itemsPerView = getItemsPerView();
    const getMaxSlide = () => Math.max(0, cards.length - itemsPerView);

    function updateCarousel() {
      if (!carousel || !dotsContainer) return;
      carousel.style.transform = `translateX(-${currentSlide * (100 / itemsPerView)}%)`;
      cards.forEach((card, index) => {
        const visible = index >= currentSlide && index < currentSlide + itemsPerView;
        card.inert = !visible;
        card.setAttribute("aria-hidden", String(!visible));
      });
      dotsContainer.querySelectorAll<HTMLButtonElement>("button").forEach((dot, index) => {
        const active = index === currentSlide;
        dot.setAttribute("aria-pressed", String(active));
        const marker = dot.firstElementChild as HTMLElement;
        marker.classList.toggle("w-6", active);
        marker.classList.toggle("bg-violet-600", active);
        marker.classList.toggle("dark:bg-violet-400", active);
        marker.classList.toggle("bg-gray-300", !active);
        marker.classList.toggle("dark:bg-gray-600", !active);
      });
      if (prevBtn) prevBtn.disabled = currentSlide === 0;
      if (nextBtn) nextBtn.disabled = currentSlide >= getMaxSlide();
      if (status) status.textContent = isEn
        ? `Projects ${currentSlide + 1}–${Math.min(currentSlide + itemsPerView, cards.length)} of ${cards.length}`
        : `Proyectos ${currentSlide + 1}–${Math.min(currentSlide + itemsPerView, cards.length)} de ${cards.length}`;
    }

    function goToSlide(index: number) {
      const focusWasInCarousel = carousel?.contains(document.activeElement);
      currentSlide = Math.max(0, Math.min(index, getMaxSlide()));
      updateCarousel();
      if (focusWasInCarousel && document.activeElement?.closest("[inert]")) {
        cards[currentSlide]?.querySelector<HTMLButtonElement>("[data-project-dialog]")?.focus({ preventScroll: true });
      }
    }

    function generateDots() {
      if (!dotsContainer) return;
      dotsContainer.replaceChildren();
      for (let index = 0; index <= getMaxSlide(); index++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "flex items-center justify-center min-w-6 h-6 rounded-full";
        dot.setAttribute("aria-label", isEn ? `Show projects from ${index + 1}` : `Mostrar proyectos desde el ${index + 1}`);
        dot.setAttribute("aria-controls", "projects-carousel");
        const marker = document.createElement("span");
        marker.className = "block size-2 rounded-full transition-all duration-300 motion-reduce:transition-none";
        dot.append(marker);
        dot.addEventListener("click", () => goToSlide(index));
        dotsContainer.append(dot);
      }
    }

    region.querySelectorAll<HTMLButtonElement>("[data-project-dialog]").forEach((button) => {
      const dialog = document.getElementById(button.dataset.projectDialog || "");
      if (!(dialog instanceof HTMLDialogElement)) return;
      const controller = bindDialog(dialog);
      button.addEventListener("click", () => {
        activeCard = button.closest<HTMLElement>(".project-card");
        controller.open(button);
      });
      dialog.addEventListener("close", () => { activeCard = null; });
    });
    prevBtn?.addEventListener("click", () => goToSlide(currentSlide - 1));
    nextBtn?.addEventListener("click", () => goToSlide(currentSlide + 1));

    let touchStartX = 0;
    let touchStartY = 0;
    carousel.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0].clientX;
      touchStartY = event.changedTouches[0].clientY;
    }, { passive: true });
    carousel.addEventListener("touchend", (event) => {
      const diffX = touchStartX - event.changedTouches[0].clientX;
      const diffY = touchStartY - event.changedTouches[0].clientY;
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) goToSlide(currentSlide + (diffX > 0 ? 1 : -1));
    }, { passive: true });
    window.addEventListener("resize", () => {
      const newItemsPerView = getItemsPerView();
      if (newItemsPerView === itemsPerView) return;
      const focusedIndex = cards.findIndex(card => card.contains(document.activeElement) || card === activeCard);
      itemsPerView = newItemsPerView;
      currentSlide = Math.min(focusedIndex >= 0 ? focusedIndex : currentSlide, getMaxSlide());
      generateDots();
      updateCarousel();
    });
    generateDots();
    updateCarousel();
  }

  initProjects();
</script>
