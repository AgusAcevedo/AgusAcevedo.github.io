---
import { useTranslations } from "../i18n";
import type { Language } from "../i18n/languages";
import { serializeJsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
}

const currentLocale = (Astro.currentLocale || 'es') as Language;
const t = useTranslations(currentLocale);

// Datos personales desde traducciones
const p = t.personal;

const {
  title = t.seo.title,
  description = t.seo.description,
  image = p.ogImage,
  canonicalUrl = new URL(Astro.url.pathname, p.siteUrl).href,
  type = 'website'
} = Astro.props;

const fullImageUrl = new URL(image, p.siteUrl).href;
const profileImageUrl = new URL(p.profileImage, p.siteUrl).href;
const imagePath = new URL(fullImageUrl).pathname.toLowerCase();
const imageType = imagePath.endsWith('.jpg') || imagePath.endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
const currentLanguage = currentLocale === 'es' ? 'es-AR' : 'en-US';
const alternateLanguage = currentLocale === 'es' ? 'en-US' : 'es-AR';
const alternatePath = currentLocale === 'es' ? '/en/' : '/';
const personId = new URL('#person', p.siteUrl).href;
const websiteId = new URL('#website', p.siteUrl).href;

// Construir array de redes sociales dinámicamente
const socialLinks: string[] = [];
if (p.linkedin) socialLinks.push(p.linkedin);
if (p.github) socialLinks.push(p.github);
if (p.twitter) socialLinks.push(p.twitter);

// Schema.org JSON-LD para persona/profesional
const schemaPersona = {
  "@type": "Person",
  "@id": personId,
  "name": p.name,
  "jobTitle": p.jobTitle,
  "description": description,
  "url": p.siteUrl,
  "image": profileImageUrl,
  "sameAs": socialLinks,
  "email": p.email,
  "knowsAbout": p.skills,
  "worksFor": {
    "@type": "Organization",
    "name": p.currentCompany
  }
};

const schemaWebsite = {
  "@type": "WebSite",
  "@id": websiteId,
  "name": `${p.name} Portfolio`,
  "url": p.siteUrl,
  "description": description,
  "inLanguage": ['es-AR', 'en-US'],
  "author": { "@id": personId }
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    schemaPersona,
    schemaWebsite,
    {
      "@type": "ProfilePage",
      "@id": new URL('#profile', canonicalUrl).href,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": currentLanguage,
      "mainEntity": { "@id": personId },
      "isPartOf": { "@id": websiteId },
    },
  ],
};
---

<!-- Primary Meta Tags -->
<meta name="description" content={description} />
<meta name="author" content={p.name} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="dW5FVklswoOeDUwMbCNMdK3Qduway3TmFeDQj_gxmK8" />

<!-- Canonical & Alternate URLs -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang={currentLanguage} href={canonicalUrl} />
<link rel="alternate" hreflang={alternateLanguage} href={new URL(alternatePath, p.siteUrl).href} />
<link rel="alternate" hreflang="x-default" href={p.siteUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={t.seo.ogTitle} />
<meta property="og:description" content={t.seo.ogDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:secure_url" content={fullImageUrl} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:alt" content={`${p.name} - ${p.jobTitle}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={currentLocale === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:locale:alternate" content={currentLocale === 'es' ? 'en_US' : 'es_AR'} />
<meta property="og:site_name" content={`${p.name} Portfolio`} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={t.seo.ogTitle} />
<meta name="twitter:description" content={t.seo.ogDescription} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={`${p.name} - ${p.jobTitle}`} />

<!-- Additional SEO -->
<meta name="theme-color" content={p.themeColor} />
<meta name="msapplication-TileColor" content={p.themeColor} />

<!-- Schema.org JSON-LD -->
<script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
