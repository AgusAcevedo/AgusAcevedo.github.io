---
import SunIcon from "./icons/Sun.astro";
import MoonIcon from "./icons/Moon.astro";
import SystemIcon from "./icons/System.astro";

const { id = "theme-menu" } = Astro.props;
const isEn = Astro.currentLocale === "en";
const themes = [
  { value: "light", label: isEn ? "Light" : "Claro" },
  { value: "dark", label: isEn ? "Dark" : "Oscuro" },
  { value: "system", label: isEn ? "System" : "Sistema" },
];
---

<div class="theme-toggle-wrapper relative ml-1 mr-1">
  <button
    id={`${id}-toggle`}
    type="button"
    class="theme-toggle-btn relative size-11 appearance-none border-none flex items-center justify-center hover:scale-110 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 rounded-md text-gray-700 dark:text-gray-200"
    aria-label={isEn ? "Change theme" : "Cambiar tema"}
    aria-controls={id}
    aria-expanded="false"
  >
    <SunIcon data-theme="light" aria-hidden="true" class="theme-toggle-icon absolute size-5 transition-all" />
    <MoonIcon data-theme="dark" aria-hidden="true" class="theme-toggle-icon absolute size-5 transition-all" />
    <SystemIcon data-theme="system" aria-hidden="true" class="theme-toggle-icon absolute size-5 transition-all" />
  </button>
  <div
    id={id}
    hidden
    class="themes-menu absolute top-12 right-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-200 bg-white/95 dark:bg-gray-900/95 dark:border-gray-600 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md z-50"
  >
    <ul aria-labelledby={`${id}-toggle`}>
      {themes.map((theme) => (
        <li>
          <button type="button"
            class="themes-menu-option w-full min-h-11 text-left px-3 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-sm aria-pressed:font-semibold aria-pressed:text-violet-600 dark:aria-pressed:text-violet-400"
            data-theme={theme.value}
            aria-pressed={theme.value === "system"}
          >{theme.label}</button>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .theme-toggle-icon { scale: 0; }
  .theme-toggle-icon[data-theme="system"] { scale: 1; }
  :global(html[data-theme="light"]) .theme-toggle-icon,
  :global(html[data-theme="dark"]) .theme-toggle-icon { scale: 0; }
  :global(html[data-theme="light"]) .theme-toggle-icon[data-theme="light"],
  :global(html[data-theme="dark"]) .theme-toggle-icon[data-theme="dark"] { scale: 1; }
  .themes-menu[hidden] { display: none; }
</style>

<script>
  type Theme = "light" | "dark" | "system";
  let cleanup = () => {};

  function initThemeToggle() {
    cleanup();
    const controller = new AbortController();
    const { signal } = controller;
    cleanup = () => controller.abort();
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const validTheme = (value: string | null): Theme =>
      value === "light" || value === "dark" ? value : "system";
    let preference: Theme = "system";
    try { preference = validTheme(localStorage.getItem("theme")); } catch { /* Storage can be unavailable. */ }

    const updateTheme = () => {
      const root = document.documentElement;
      root.dataset.theme = preference;
      const isDark = preference === "dark" || (preference === "system" && media.matches);
      root.classList.toggle("dark", isDark);
      root.style.colorScheme = isDark ? "dark" : "light";
      document.querySelectorAll<HTMLButtonElement>(".themes-menu-option").forEach((option) => {
        option.setAttribute("aria-pressed", String(option.dataset.theme === preference));
      });
    };
    updateTheme();
    media.addEventListener("change", updateTheme, { signal });
    window.addEventListener("storage", (event) => {
      if (event.key === "theme" || event.key === null) {
        preference = validTheme(event.newValue);
        updateTheme();
      }
    }, { signal });

    document.querySelectorAll<HTMLElement>(".theme-toggle-wrapper").forEach((wrapper) => {
      const toggle = wrapper.querySelector<HTMLButtonElement>(".theme-toggle-btn");
      const menu = wrapper.querySelector<HTMLElement>(".themes-menu");
      const options = Array.from(wrapper.querySelectorAll<HTMLButtonElement>(".themes-menu-option"));
      if (!toggle || !menu) return;
      const close = (restoreFocus = false) => {
        menu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        if (restoreFocus) toggle.focus();
      };
      const open = () => {
        document.dispatchEvent(new CustomEvent("portfolio:menu-open", { detail: menu.id }));
        menu.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
      };
      toggle.addEventListener("click", () => menu.hidden ? open() : close(), { signal });
      toggle.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          open();
          (event.key === "ArrowUp" ? options.at(-1) : options.find((option) => option.dataset.theme === preference) || options[0])?.focus();
        }
      }, { signal });
      options.forEach((option) => option.addEventListener("click", () => {
        preference = validTheme(option.dataset.theme || null);
        try { localStorage.setItem("theme", preference); } catch { /* Continue without persistence. */ }
        updateTheme();
        close(true);
      }, { signal }));
      wrapper.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !menu.hidden) {
          event.preventDefault();
          event.stopPropagation();
          close(true);
        } else if (event.target !== toggle && ["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
          event.preventDefault();
          const index = options.indexOf(document.activeElement as HTMLButtonElement);
          const next = event.key === "Home" ? 0 : event.key === "End" ? options.length - 1 : (index + (event.key === "ArrowDown" ? 1 : -1) + options.length) % options.length;
          options[next]?.focus();
        }
      }, { signal });
      wrapper.addEventListener("focusout", (event) => {
        if (!wrapper.contains(event.relatedTarget as Node | null)) close();
      }, { signal });
      document.addEventListener("click", (event) => {
        if (!wrapper.contains(event.target as Node)) close();
      }, { signal });
      document.addEventListener("portfolio:menu-open", (event) => {
        if ((event as CustomEvent<string>).detail !== menu.id) close();
      }, { signal });
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>
