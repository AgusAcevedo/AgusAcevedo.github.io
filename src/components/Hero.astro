---
import { useTranslations } from "../i18n";
import type { Language } from "../i18n/languages";
const currentLocale = (Astro.currentLocale || 'es') as Language;
const t = useTranslations(currentLocale);

// Datos personales centralizados
const p = t.personal;
const resumeFile = currentLocale === 'en' ? 'CV-Agustin-Acevedo-EN.pdf' : 'CV-Agustin-Acevedo-ES.pdf';

import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import LinkedinPill from "@/components/LinkedinPill.astro";
import DownloadPill from "@/components/DownloadPill.astro";
---

<div class="flex flex-col items-center gap-8 lg:flex-row lg:gap-10">
  <img
    width="320"
    height="320"
    src={p.profileImage}
    alt={p.name}
    class="size-64 shrink-0 rounded-full bg-white object-cover p-1 ring-1 ring-white/20 sm:size-72 lg:size-80 lg:p-2 dark:bg-violet-500/5"
    fetchpriority="high"
    loading="eager"
  />
  <div class="min-w-0 flex-1 text-center lg:text-left">
    <h1
      class="text-balance text-2xl font-bold tracking-tight text-gray-800 sm:text-4xl dark:text-white"
    >
      {p.name}
    </h1>
    <p class="mt-4 text-balance text-xl font-semibold text-violet-600 dark:text-violet-200">{t.hero.role}</p>
    <p class="mt-4 text-pretty text-lg leading-relaxed text-gray-700 dark:text-gray-300">
      {t.hero.description}
    </p>
    <nav aria-label={currentLocale === 'es' ? 'Contacto y currículum' : 'Contact and resume'} class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start">
      <SocialPill href={`mailto:${p.email}`}>
        <MailIcon class="size-4" />
        {t.hero.contact}
      </SocialPill>

      <DownloadPill href={`/${resumeFile}`} download={resumeFile} hreflang={currentLocale}>{t.hero.cv}</DownloadPill>

      <LinkedinPill href={p.linkedin}>
        <LinkedInIcon class="size-4" />
        LinkedIn
      </LinkedinPill>
    </nav>
  </div>
</div>
