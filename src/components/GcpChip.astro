---
import Google from './icons/Google.astro';

interface Props {
  variant?: 'default' | 'modal' | 'compact';
}

const { variant = 'default' } = Astro.props;
---

<span
  title="Google Cloud"
  class:list={[
    'inline-flex items-center gap-2 rounded-full bg-black text-xs text-white',
    {
      'h-8 px-3': variant === 'default',
      'py-1 px-3': variant === 'modal',
      'h-6 px-2': variant === 'compact',
    },
  ]}
>
  <Google class={variant === 'compact' ? 'size-3.5' : 'size-4'} aria-hidden="true" />
  GCP
</span>
