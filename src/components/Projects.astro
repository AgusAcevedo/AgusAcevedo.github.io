    link: "https://www.cloudskillsboost.google/public_profiles/9b7d33b5-f2b7-4736-b5df-e4537f1f7f03/badges/3112739",
    image: "/webp_certs/ServerlessCloudRun.webp",
    categories: ["Cloud", "Backend"],
  },
  {
